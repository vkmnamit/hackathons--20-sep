# ==============================================================================
# GRIDPOINT / Wherehouse — Environment Configuration Reference
# ==============================================================================

# Server Port (Railway / Render / Heroku automatically inject PORT)
PORT=4000

# ------------------------------------------------------------------------------
# LLM / AI Plan Review & Expansion Advisor (Optional - Template fallback included)
# ------------------------------------------------------------------------------
# OpenRouter API Key (Recommended for multi-model access)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# OpenAI API Key (Fallback if OpenRouter is unset)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# Google Gemini API Key (Optional)
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Supabase Persistence & Database Sync (Optional - Local memory fallback included)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://your-project.supabase.co)
supabase-project-id=
# Supabase Anon / Public Key
supabase-anon-key=
# Supabase Service Role Secret Key (Required for server-side persistence)
supabase-service-key=

# ------------------------------------------------------------------------------
# Authentication & JWT Security
# ------------------------------------------------------------------------------
JWT_SECRET=your-secure-jwt-secret-string-here

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite)
# ------------------------------------------------------------------------------
# Public browser token from Mapbox (starts with pk.). Leave blank to use Carto's no-key basemap fallback.
VITE_MAPBOX_ACCESS_TOKEN=

# API URL override (Leave blank when frontend and backend are hosted on same domain)
# VITE_API_URL=http://localhost:4000
